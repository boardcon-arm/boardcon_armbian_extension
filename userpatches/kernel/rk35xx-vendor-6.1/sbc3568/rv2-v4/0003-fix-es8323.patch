diff --git a/sound/soc/codecs/es8323.c b/sound/soc/codecs/es8323.c
index 9c023c752..04a6d04b2 100644
--- a/sound/soc/codecs/es8323.c
+++ b/sound/soc/codecs/es8323.c
@@ -93,6 +93,8 @@ struct es8323_priv {
 	struct snd_pcm_hw_constraint_list sysclk_constraints;
 	struct snd_soc_component *component;
 	struct regmap *regmap;
+	u32 differential_input;
+	u8 dac_power;	
 };
 
 static int es8323_reset(struct snd_soc_component *component)
@@ -793,8 +795,20 @@ static int es8323_probe(struct snd_soc_component *component)
 	snd_soc_component_write(component, 0x06, 0xC3);
 	snd_soc_component_write(component, 0x19, 0x02);
 	snd_soc_component_write(component, 0x09, 0x00);
-	snd_soc_component_write(component, 0x0A, 0xf8);
-	snd_soc_component_write(component, 0x0B, 0x82);
+//	snd_soc_component_write(component, 0x0A, 0xf8);
+//	snd_soc_component_write(component, 0x0B, 0x82);
+
+	/* Left/Right PGA both use differential input */
+  snd_soc_component_update_bits(component, ES8323_ADCCONTROL2, 0xfc,0xf0);
+  
+  if (es8323->differential_input == 2) {
+  	/* LIN2 - RIN2 */
+  	snd_soc_component_update_bits(component,ES8323_ADCCONTROL3, 0x80, 0x80);
+  } else {
+  	/* LIN1 - RIN1 */
+  	snd_soc_component_update_bits(component,ES8323_ADCCONTROL3,0x80,0x00);
+  }
+
 	snd_soc_component_write(component, 0x0C, 0x0C);
 	snd_soc_component_write(component, 0x0D, 0x02);
 	snd_soc_component_write(component, 0x10, 0x00);
@@ -819,7 +833,8 @@ static int es8323_probe(struct snd_soc_component *component)
 	snd_soc_component_write(component, 0x03, 0x09);
 	snd_soc_component_write(component, 0x02, 0x00);
 	usleep_range(18000, 20000);
-	snd_soc_component_write(component, 0x04, 0x3C);
+//	snd_soc_component_write(component, 0x04, 0x3C);
+	snd_soc_component_write(component, ES8323_DACPOWER, es8323->dac_power);
 
 	es8323_set_bias_level(component, SND_SOC_BIAS_OFF);
 	return 0;
@@ -862,6 +877,7 @@ static int es8323_i2c_probe(struct i2c_client *i2c,
 	int ret = -1;
 	struct i2c_adapter *adapter = to_i2c_adapter(i2c->dev.parent);
 	char reg;
+	u32 val;
 
 	if (!i2c_check_functionality(adapter, I2C_FUNC_I2C)) {
 		dev_warn(&adapter->dev,
@@ -873,6 +889,30 @@ static int es8323_i2c_probe(struct i2c_client *i2c,
 	if (!es8323)
 		return -ENOMEM;
 
+  es8323->differential_input = 1;
+  es8323->dac_power = 0x0c;
+  
+  if (!of_property_read_u32(i2c->dev.of_node,
+  			  "everest,differential-input", &val))
+  	es8323->differential_input = val;
+  
+  if (!of_property_read_u32(i2c->dev.of_node,
+  			  "everest,dac-output", &val)) {
+  	switch (val) {
+  	case 1:
+  		es8323->dac_power = 0x30; /* OUT1 */
+  		break;
+  	case 2:
+  		es8323->dac_power = 0x0c; /* OUT2 */
+  		break;
+  	case 3:
+  		es8323->dac_power = 0x3c; /* OUT1 + OUT2 */
+  		break;
+  	default:
+  		break;
+  	}
+  }
+
 	es8323->regmap = devm_regmap_init_i2c(i2c, &es8323_regmap_config);
 	if (IS_ERR(es8323->regmap))
 		return PTR_ERR(es8323->regmap);
